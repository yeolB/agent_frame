#!/usr/bin/env bash

set -euo pipefail

repo_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
memory_root="$repo_root/memory"

if [[ ! -d "$memory_root" ]]; then
  echo "memory/ not found" >&2
  exit 1
fi

echo "memory/"

while IFS= read -r -d '' file; do
  relative_path="${file#"$memory_root/"}"
  heading="$(awk '/^#[[:space:]]+/ { sub(/^#[[:space:]]+/, ""); print; exit }' "$file")"

  if [[ -z "$heading" ]]; then
    heading="(missing H1)"
  fi

  printf '  %-40s %s\n' "$relative_path" "— $heading"
done < <(find "$memory_root" -type f -name '*.md' -print0 | sort -z)
