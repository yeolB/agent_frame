#!/usr/bin/env bash

set -euo pipefail

repo_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"

required_paths=(
  "AGENTS.md"
  "ARCHITECTURE.md"
  ".codex/agents/coder.toml"
  ".codex/agents/reviewer.toml"
  ".codex/agents/steward.toml"
  "memory/direction.md"
  "memory/domains/_README.md"
  "memory/domains/_index-template.md"
  "state/README.md"
  "state/_task-template.md"
  "state/active"
  "scripts/context-map"
  "templates/local-AGENTS.md"
  "templates/local-ARCHITECTURE.md"
)

for relative_path in "${required_paths[@]}"; do
  if [[ ! -e "$repo_root/$relative_path" ]]; then
    echo "Missing required path: $relative_path" >&2
    exit 1
  fi
done

for agent_file in "$repo_root"/.codex/agents/*.toml; do
  for required_key in name description developer_instructions; do
    if ! grep -Eq "^${required_key}[[:space:]]*=" "$agent_file"; then
      echo "Missing required custom-agent key '$required_key': ${agent_file#"$repo_root/"}" >&2
      exit 1
    fi
  done
done

"$repo_root/scripts/context-map" >/dev/null

# Add project-specific lint, typecheck, test, and build commands below.
# Keep this script as the single verification entry point for agents.

echo "Framework checks passed. No project-specific checks are configured."
