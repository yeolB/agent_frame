{
  "description": "Track changed Codex turns without model calls, surface due work before the next turn, and recover missed Stop events.",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$(git rev-parse --show-toplevel)/scripts/continuity\" session-start",
            "timeout": 3,
            "additionalContextLimit": 1000,
            "statusMessage": "Checking repository continuity"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$(git rev-parse --show-toplevel)/scripts/continuity\" turn-start",
            "timeout": 3,
            "additionalContextLimit": 1000,
            "statusMessage": "Checking repository continuity"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$(git rev-parse --show-toplevel)/scripts/continuity\" turn-stop",
            "timeout": 3
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$(git rev-parse --show-toplevel)/scripts/continuity\" session-end",
            "timeout": 3
          }
        ]
      }
    ]
  }
}
